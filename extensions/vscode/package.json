{
  "name": "rmux",
  "displayName": "rmux",
  "description": "Open or reuse your project's rmux workspace with the external terminal shortcut.",
  "version": "0.1.0",
  "publisher": "rmuxapp",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "repository": { "type": "git", "url": "https://github.com/rmuxapp/rmux" },
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": false },
  "contributes": {
    "commands": [{ "command": "rmux.openProject", "title": "rmux: Open Project Workspace" }],
    "keybindings": [{
      "command": "rmux.openProject", "key": "ctrl+shift+c", "mac": "cmd+shift+c",
      "when": "workspaceFolderCount > 0 && isWorkspaceTrusted && !remoteName && !isWindows"
    }],
    "configuration": {
      "title": "rmux",
      "properties": {
        "rmux.socketPath": {
          "type": "string", "default": "~/.rmux-automation/rpc.sock", "scope": "application",
          "description": "Absolute path to the running local rmux socket. A leading ~/ uses your home directory."
        }
      }
    }
  },
  "scripts": { "test": "node --test test/*.test.js" }
}
